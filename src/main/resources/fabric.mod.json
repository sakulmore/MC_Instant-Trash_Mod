{
	"schemaVersion": 1,
	"id": "instant-trash",
	"version": "${version}",
	"name": "Instant Trash",
	"description": "A mod that allows you to easily delete items from your inventory or chests.",
	"authors": [
		"sakulmore"
	],
	"icon": "assets/instant-trash/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.instanttrash.InstantTrash"
		],
		"client": [
			"com.instanttrash.client.InstantTrashClient"
		]
	},
	"mixins": [
		"instant-trash.mixins.json",
		{
			"config": "instant-trash.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.1 <=26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}